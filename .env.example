# ==============================================================================
# PEBLO TV MINI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or set in your production secrets manager.
# ==============================================================================

# Project & Environment
PROJECT_NAME="Peblo TV Mini API"
VERSION="1.0.0"
ENVIRONMENT="development" # development | staging | production
DEBUG=true

# Database (PostgreSQL 16)
# Async URL for FastAPI (asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/peblo_tv"
# Sync URL for Alembic Migrations (psycopg2)
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peblo_tv"

# Storage Backend: 'local' or 's3' (MinIO / AWS S3 / Cloudflare R2)
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="./storage_data"
STORAGE_PUBLIC_URL_PREFIX="/storage"

# S3 / MinIO / Cloudflare R2 Configuration (Required if STORAGE_BACKEND=s3)
S3_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY="your-r2-access-key-id"
S3_SECRET_KEY="your-r2-secret-access-key"
S3_BUCKET_NAME="peblo-tv-catalog"
S3_REGION_NAME="auto"
S3_PUBLIC_BASE_URL="https://pub-cdn.peblo.tv"

# Security & JWT Authentication
SECRET_KEY="peblo-tv-change-this-in-production-to-a-high-entropy-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# Published Catalogue Target Path
CATALOG_FILE_PATH="catalog/catalog.json"

# Production Secrets Management Note:
# In production, never commit plaintext credentials to source control. Inject secrets via
# HashiCorp Vault, AWS Secrets Manager, or Kubernetes SealedSecrets / GitHub Action Secrets.
